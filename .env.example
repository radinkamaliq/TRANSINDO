# ─── Backend (Node.js / Express) ──────────────────────────────────────────────
# PostgreSQL connection string — REQUIRED for production.
# Vercel stores this as a project Environment Variable (Server type).
DATABASE_URL=postgresql://user:password@localhost:5432/transit

# JWT secret used to sign auth tokens.  Generate a secure random value.
# Example: openssl rand -base64 32
JWT_SECRET=transit_default_secret_key_2026

# Origin URL of the frontend for CORS.
# In production on Vercel this is the deployment URL, e.g.:
#   FRONTEND_ORIGIN=https://transit-jabodetabek.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Cookie name for the auth-token HTTP-only cookie (optional, has fallback)
COOKIE_NAME=auth_token

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Optional base URL for API calls.  Leave unset in production — the frontend
# uses relative /api/* paths which Vercel routes to the backend service.
# Only set this for non-default deployments (e.g. staging sub-paths).
# VITE_API_BASE_URL=
